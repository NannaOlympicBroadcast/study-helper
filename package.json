{
  "name": "study-helper",
  "productName": "StudyHelper",
  "version": "0.1.0",
  "description": "���и�ϰ���֣���������� + רעģʽ + ֪ʶ�ټǿ�Ƭ + ѧϰʱ������ + MCP ����",
  "main": "src/main/main.js",
  "author": "NannaOlympicBroadcast",
  "license": "MIT",
  "repository": "https://github.com/NannaOlympicBroadcast/study-helper",
  "scripts": {
    "build:renderer": "node scripts/build-renderer.mjs",
    "build:mcp": "node scripts/build-mcp.mjs",
    "start": "npm run build:renderer && electron .",
    "test": "node --test test/core.test.js",
    "dist:win": "npm run build:renderer && electron-builder --win --publish never",
    "pack:mcpb": "npm run build:mcp && node scripts/pack-mcpb.mjs"
  },
  "build": {
    "appId": "io.github.nannaolympicbroadcast.studyhelper",
    "productName": "StudyHelper",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/main/**",
      "src/shared/**",
      "dist/renderer/**",
      "assets/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "StudyHelper-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "StudyHelper-Portable-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "katex": "^0.19.0",
    "marked": "^18.0.14",
    "zod": "^4.6.5"
  }
}
